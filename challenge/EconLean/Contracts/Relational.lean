structure IsSelfEnforcing (y c : E → ℝ) (δ : ℝ) (K : RelContract E) : Prop where
  recU : ∀ t, K.U t = K.w t + K.b t - c (K.e t) + δ * K.U (t + 1)
  recP : ∀ t, K.P t = y (K.e t) - K.w t - K.b t + δ * K.P (t + 1)
