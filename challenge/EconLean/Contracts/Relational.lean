  payP : ∀ t, K.b t ≤ δ * K.P (t + 1)
  payU : ∀ t, -K.b t ≤ δ * K.U (t + 1)

noncomputable def stationaryRel (c : E → ℝ) (δ : ℝ) (e : E) (u π : ℝ) : RelContract E where
  e _ := e
  w _ := u + c e - δ * (π / (1 - δ))
  b _ := δ * (π / (1 - δ))
  U _ := u / (1 - δ)
  P _ := π / (1 - δ)

