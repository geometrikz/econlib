  ∑ g, ∑ t, resid Y D a l b g t ^ 2

def IsTWFE (Y D : G → T → ℝ) (a : G → ℝ) (l : T → ℝ) (b : ℝ) : Prop :=
  ∀ a' l' b', ssr Y D a l b ≤ ssr Y D a' l' b'

