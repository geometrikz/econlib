def wnV (t : ℕ) (ω : ℕ → Bool) : Unit → ℝ := fun _ => rad (2 * t) ω

def wnW (t : ℕ) (ω : ℕ → Bool) : Unit → ℝ := fun _ => rad (2 * t + 1) ω

