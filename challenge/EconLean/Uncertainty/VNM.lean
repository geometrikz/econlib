    IsClosed {α : ℝ | α ∈ Set.Icc (0 : ℝ) 1 ∧ R (mix α L L') L''} ∧
    IsClosed {α : ℝ | α ∈ Set.Icc (0 : ℝ) 1 ∧ R L'' (mix α L L')}
  
