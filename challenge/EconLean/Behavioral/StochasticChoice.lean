def IsChoiceRule (P : Finset X → X → ℝ) : Prop :=
  ∀ A : Finset X, A.Nonempty →
    (∀ a, 0 ≤ P A a) ∧ (∀ a, a ∉ A → P A a = 0) ∧ ∑ a ∈ A, P A a = 1

noncomputable def luce (w : X → ℝ) (A : Finset X) (a : X) : ℝ :=
  if a ∈ A then w a / ∑ b ∈ A, w b else 0

omit [Fintype X] in
