  sorry

noncomputable def probSet (P : Finset X → X → ℝ) (A B : Finset X) : ℝ := ∑ b ∈ B, P A b

def ChoiceAxiom (P : Finset X → X → ℝ) : Prop :=
  ∀ A B : Finset X, B ⊆ A → ∀ a ∈ B, P A a = probSet P A B * P B a

