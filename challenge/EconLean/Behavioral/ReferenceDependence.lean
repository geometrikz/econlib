def mugMoney (v : ℝ) : Fin 2 → ℝ → ℝ := fun k x => if k = 0 then v * x else x

noncomputable def WTA (η lam v : ℝ) : ℝ := v * (1 + η * lam) / (1 + η)

noncomputable def WTP (η lam v : ℝ) : ℝ := v * (1 + η) / (1 + η * lam)

