abbrev Bundle (σ : Type*) := ℝ × (σ → ℝ)

variable [Fintype σ] in

def adBudget (m : σ → ℝ) (e x : Bundle σ) : Prop :=
  x.1 + ∑ s, m s * x.2 s ≤ e.1 + ∑ s, m s * e.2 s

