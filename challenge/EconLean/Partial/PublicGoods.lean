def publicSurplus (φ : I → ℝ → ℝ) (C : ℝ → ℝ) (G : ℝ) : ℝ := ∑ i, φ i G - C G

def IsEfficientLevel (φ : I → ℝ → ℝ) (C : ℝ → ℝ) (G : ℝ) : Prop :=
  0 ≤ G ∧ ∀ G', 0 ≤ G' → publicSurplus φ C G' ≤ publicSurplus φ C G

