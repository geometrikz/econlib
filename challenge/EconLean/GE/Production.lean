def ProfitMax (p : ι → ℝ) (Y : Set (ι → ℝ)) (y : ι → ℝ) : Prop :=
  y ∈ Y ∧ ∀ y' ∈ Y, cost p y' ≤ cost p y

def wealth (p : ι → ℝ) (y : β → ι → ℝ) (a : α) : ℝ :=
