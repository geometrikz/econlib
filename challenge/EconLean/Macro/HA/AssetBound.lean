def EulerGap (u : ℝ → ℝ) (β R y c : ℝ) : Prop :=
  ∀ ε > 0, ∃ d, 0 < d ∧ d ≤ ε ∧ R * d ≤ c - y ∧
    β * (u (c - y) - u (c - y - R * d)) < u (c + d) - u c

