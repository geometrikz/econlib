/-
# Stochastic Brock–Mirman: optimality of the closed-form policy

Brock–Mirman (1972); Stokey–Lucas–Prescott §9.1–9.2 and Exercise 10.1;
Ljungqvist–Sargent ch. 3.2.

**The model.** A planner with log utility and output `A(z) k^α` (full
depreciation) chooses next period's capital `k'`, `0 < k' < A(z) k^α`, after
observing today's productivity shock `z`. Shocks are i.i.d. over a finite set
`Z` with probabilities `q`. The objective is
`E[Σ_t β^t log(A(z_t) k_t^α - k_{t+1})]`.

**Contingent plans.** As in `StochasticPlan`, a plan is a function on shock
histories, `σ : List Z → ℝ`: `σ []` is next period's capital chosen today, and
`σ [z₁, …, zₙ]` is the capital chosen after observing `z₁, …, zₙ`. A plan is
feasible from `(k, z)` if every choice leaves positive consumption and positive
capital (`FeasN`, `Feasible`). The `n`-period expected payoff `J n σ s` is
defined by backward recursion; with finitely many shocks this is exactly
`E[Σ_{t<n} β^t log c_t]`. Log utility is unbounded below, so the payoff of a
plan need not converge; optimality is stated as in `SequenceProblem`
(`IsOptimalValue`): the policy plan's payoffs converge to the value, and for
every feasible plan the payoffs are eventually below the value plus `ε`.

**Results.**
* `bellman_le`, `bellman_eq`: the closed form
  `V(k, z) = a(z) + (α / (1 - αβ)) log k` satisfies the Bellman equation with
  the maximum attained at `k' = αβ A(z) k^α` (the saving rate `αβ` does not
  depend on the shock).
* `stochastic_brockMirman`: from every `(k₀, z₀)` with `k₀ > 0`, the plan
  generated by `k' = αβ A(z) k^α` is feasible, its expected payoffs converge to
  `V(k₀, z₀)`, and no feasible plan does better (`limsup J_n ≤ V`).

**Method.** The verification argument of `verification_of_lowerBound`
(deterministic) carried out in expectation: a telescoping bound
`J_n + β^n E[V(s_n)] ≤ V(s₀)`, and the lower bound
`a₀ + (1/(1-αβ)) log c ≤ V(k, z)` that offsets the unboundedness of `V` below.
Along the policy plan `log k_t` stays bounded, so `β^n E[V(s_n)] → 0`.

**Scope.** Shocks are i.i.d. with finitely many values; the value function
intercept `a(z)` is explicit. Markov shocks would need `a = b + βQa`, not
formalized here.
-/
module

public import EconLean.Macro.DP.BrockMirman

@[expose] public section

namespace Econ

namespace StochBrockMirman

open Real Filter Topology Set Finset

/-- Parameters: `0 < α, β < 1`, productivity `A(z) > 0`, i.i.d. shock
probabilities `q`. -/
structure Params (Z : Type*) [Fintype Z] where
  α : ℝ
  β : ℝ
  A : Z → ℝ
  q : Z → ℝ
  α_pos : 0 < α
  α_lt_one : α < 1
  β_pos : 0 < β
  β_lt_one : β < 1
  A_pos : ∀ z, 0 < A z
  q_nonneg : ∀ z, 0 ≤ q z
  q_sum : ∑ z, q z = 1

variable {Z : Type*} [Fintype Z]

/-- The continuation of a plan after the shock `z`. -/
def shift (σ : List Z → ℝ) (z : Z) : List Z → ℝ := fun h => σ (z :: h)

namespace Params

variable (P : Params Z)

/-- Output `A(z) k^α` at the state `s = (k, z)`. -/
noncomputable def y (s : ℝ × Z) : ℝ := P.A s.2 * s.1 ^ P.α

/-- Period return `log c = log(A(z) k^α - k')`. -/
noncomputable def F (s : ℝ × Z) (k' : ℝ) : ℝ := log (P.y s - k')

/-- The plan is feasible for `n` periods from `s`: positive capital and
consumption at every node up to date `n`. -/
def FeasN : ℕ → (List Z → ℝ) → ℝ × Z → Prop
  | 0, _, _ => True
  | n + 1, σ, s => 0 < σ [] ∧ σ [] < P.y s ∧ ∀ z', FeasN n (shift σ z') (σ [], z')

/-- The plan is feasible from `s` (at every date). -/
def Feasible (σ : List Z → ℝ) (s : ℝ × Z) : Prop := ∀ n, P.FeasN n σ s

/-- Expected `n`-period payoff `E[Σ_{t<n} β^t log c_t]`. -/
noncomputable def J : ℕ → (List Z → ℝ) → ℝ × Z → ℝ
  | 0, _, _ => 0
  | n + 1, σ, s => P.F s (σ []) + P.β * ∑ z', P.q z' * J n (shift σ z') (σ [], z')

/-- Expected date-`n` return `E[log c_n]`. -/
noncomputable def R : ℕ → (List Z → ℝ) → ℝ × Z → ℝ
  | 0, σ, s => P.F s (σ [])
  | n + 1, σ, _ => ∑ z', P.q z' * R n (shift σ z') (σ [], z')

/-- Expected value of `v` at the date-`n` state, `E[v(s_n)]`. -/
noncomputable def T (v : ℝ × Z → ℝ) : ℕ → (List Z → ℝ) → ℝ × Z → ℝ
  | 0, _, s => v s
  | n + 1, σ, _ => ∑ z', P.q z' * T v n (shift σ z') (σ [], z')

/-- The plan generated by a policy `g` from a state: `σ [] = g(s)`, and after
the shock `z` continue from `(g(s), z)`. -/
def policyPlan (g : ℝ × Z → ℝ) : List Z → ℝ × Z → ℝ
  | [], s => g s
  | z :: h, s => policyPlan g h (g s, z)

omit [Fintype Z] in
theorem shift_policyPlan (g : ℝ × Z → ℝ) (s : ℝ × Z) (z : Z) :
    shift (fun h => policyPlan g h s) z = fun h => policyPlan g h (g s, z) := rfl

/-- The closed-form policy `k' = αβ A(z) k^α`. -/
noncomputable def g (s : ℝ × Z) : ℝ := P.α * P.β * P.y s

/-- Slope of the value function, `B = α / (1 - αβ)`. -/
noncomputable def B : ℝ := P.α / (1 - P.α * P.β)

/-- `K = log(1 - αβ) + (αβ / (1 - αβ)) log(αβ)`. -/
noncomputable def K : ℝ := log (1 - P.α * P.β) + P.α * P.β / (1 - P.α * P.β) * log (P.α * P.β)

/-- Mean of the intercept, `ā = (K + E[log A] / (1 - αβ)) / (1 - β)`. -/
noncomputable def abar : ℝ :=
  (P.K + (∑ z, P.q z * log (P.A z)) / (1 - P.α * P.β)) / (1 - P.β)

/-- Intercept `a(z) = K + log A(z) / (1 - αβ) + β ā`. -/
noncomputable def a (z : Z) : ℝ := P.K + log (P.A z) / (1 - P.α * P.β) + P.β * P.abar

/-- The closed-form value function `V(k, z) = a(z) + B log k`. -/
noncomputable def V (s : ℝ × Z) : ℝ := P.a s.2 + P.B * log s.1

theorem ab_pos : 0 < P.α * P.β := mul_pos P.α_pos P.β_pos

theorem ab_lt_one : P.α * P.β < 1 := by nlinarith [P.α_pos, P.α_lt_one, P.β_pos, P.β_lt_one]

theorem one_sub_ab_pos : 0 < 1 - P.α * P.β := by linarith [P.ab_lt_one]

theorem y_pos {s : ℝ × Z} (hk : 0 < s.1) : 0 < P.y s :=
  mul_pos (P.A_pos _) (rpow_pos_of_pos hk _)

theorem sum_qa : ∑ z, P.q z * P.a z = P.abar := by
  have h1 := P.one_sub_ab_pos
  have h2 : (0 : ℝ) < 1 - P.β := by linarith [P.β_lt_one]
  have e : ∀ z, P.q z * P.a z = P.q z * (P.K + P.β * P.abar) +
      P.q z * log (P.A z) * (1 - P.α * P.β)⁻¹ := fun z => by unfold a; ring
  rw [sum_congr rfl fun z _ => e z, sum_add_distrib, ← sum_mul, ← sum_mul, P.q_sum, one_mul]
  unfold abar
  field_simp
  ring

/-- The expected continuation value of saving `k' > 0`:
`Σ q(z') V(k', z') = ā + B log k'`. -/
theorem sum_qV (k' : ℝ) : ∑ z', P.q z' * P.V (k', z') = P.abar + P.B * log k' := by
  simp only [V, mul_add, sum_add_distrib, P.sum_qa, ← sum_mul, P.q_sum, one_mul]

/-- `V(k, z) = log((1-αβ) y) + β(ā + B log(αβ y))`, the value at the
closed-form policy, in terms of output `y = A(z) k^α`. -/
theorem V_eq {s : ℝ × Z} (hk : 0 < s.1) :
    P.V s = log ((1 - P.α * P.β) * P.y s) + P.β * (P.abar + P.B * log (P.α * P.β * P.y s)) := by
  have h1 := P.one_sub_ab_pos
  have hab := P.ab_pos
  have hy := P.y_pos hk
  have hA := P.A_pos s.2
  have hyl : log (P.y s) = log (P.A s.2) + P.α * log s.1 := by
    unfold y; rw [log_mul hA.ne' (rpow_pos_of_pos hk _).ne', log_rpow hk]
  rw [log_mul h1.ne' hy.ne', log_mul hab.ne' hy.ne', hyl]
  unfold V a B K
  field_simp
  ring

/-- **Bellman equality at the closed-form policy.** -/
theorem bellman_eq {s : ℝ × Z} (hk : 0 < s.1) :
    P.F s (P.g s) + P.β * ∑ z', P.q z' * P.V (P.g s, z') = P.V s := by
  rw [P.sum_qV, P.V_eq hk]
  unfold F g
  congr 1
  ring_nf

/-- **Bellman inequality**: for every feasible `k'`,
`log(y - k') + β E[V(k', z')] ≤ V(k, z)`. Proof: `log x ≤ x - 1` applied to
consumption and saving relative to their optimal values. -/
theorem bellman_le {s : ℝ × Z} (hk : 0 < s.1) {k' : ℝ} (hk'0 : 0 < k') (hk'1 : k' < P.y s) :
    P.F s k' + P.β * ∑ z', P.q z' * P.V (k', z') ≤ P.V s := by
  rw [P.sum_qV, P.V_eq hk]
  unfold F
  have h1 := P.one_sub_ab_pos
  have hab := P.ab_pos
  have hα := P.α_pos.ne'
  have hβ := P.β_pos.ne'
  have hy := P.y_pos hk
  set y := P.y s
  set θ := P.α * P.β / (1 - P.α * P.β)
  have hθ : 0 ≤ θ := div_nonneg hab.le h1.le
  have hβB : P.β * P.B = θ := by unfold B; ring
  -- `log(c/c*) ≤ c/c* - 1` and `log(k'/k*) ≤ k'/k* - 1`
  have e1 := log_le_sub_one_of_pos (show 0 < (y - k') / ((1 - P.α * P.β) * y) by
    apply div_pos <;> nlinarith)
  have e2 := log_le_sub_one_of_pos (show 0 < k' / (P.α * P.β * y) by positivity)
  rw [log_div (by linarith) (by positivity)] at e1
  rw [log_div hk'0.ne' (by positivity)] at e2
  have hsum : (y - k') / ((1 - P.α * P.β) * y) - 1 + θ * (k' / (P.α * P.β * y) - 1) = 0 := by
    simp only [θ]; field_simp; ring
  have h3 := mul_le_mul_of_nonneg_left e2 hθ
  have h4 : P.β * (P.abar + P.B * log k') = P.β * P.abar + θ * log k' := by rw [← hβB]; ring
  have h5 : P.β * (P.abar + P.B * log (P.α * P.β * y)) =
      P.β * P.abar + θ * log (P.α * P.β * y) := by rw [← hβB]; ring
  rw [h4, h5]
  nlinarith

/-- **Lower bound by today's return**: `a₀ + (1/(1-αβ)) log(y - k') ≤ V(k, z)`
with `a₀ = K + β ā` (log consumption is below log output). -/
theorem lowerBound {s : ℝ × Z} (hk : 0 < s.1) {k' : ℝ} (hk'0 : 0 < k') (hk'1 : k' < P.y s) :
    P.K + P.β * P.abar + 1 / (1 - P.α * P.β) * P.F s k' ≤ P.V s := by
  have h1 := P.one_sub_ab_pos
  have hy := P.y_pos hk
  have hA := P.A_pos s.2
  have hlog : log (P.y s - k') ≤ log (P.A s.2) + P.α * log s.1 := by
    have : log (P.y s - k') ≤ log (P.y s) := log_le_log (by linarith) (by linarith)
    unfold y at this ⊢
    rwa [log_mul hA.ne' (rpow_pos_of_pos hk _).ne', log_rpow hk] at this
  have hb : 0 < 1 / (1 - P.α * P.β) := by positivity
  have := mul_le_mul_of_nonneg_left hlog hb.le
  unfold F V a B
  have e : 1 / (1 - P.α * P.β) * (log (P.A s.2) + P.α * log s.1) =
      log (P.A s.2) / (1 - P.α * P.β) + P.α / (1 - P.α * P.β) * log s.1 := by ring
  linarith

/-! ### Expected payoffs -/

theorem J_succ (n : ℕ) : ∀ (σ : List Z → ℝ) (s : ℝ × Z),
    P.J (n + 1) σ s = P.J n σ s + P.β ^ n * P.R n σ s := by
  induction n with
  | zero => intro σ s; simp [J, R]
  | succ n ih =>
    intro σ s
    show P.F s (σ []) + P.β * ∑ z', P.q z' * P.J (n + 1) (shift σ z') (σ [], z') =
      (P.F s (σ []) + P.β * ∑ z', P.q z' * P.J n (shift σ z') (σ [], z')) +
        P.β ^ (n + 1) * ∑ z', P.q z' * P.R n (shift σ z') (σ [], z')
    simp only [ih, mul_add, sum_add_distrib, mul_sum]
    have e : ∀ z, P.β * (P.q z * (P.β ^ n * P.R n (shift σ z) (σ [], z))) =
        P.β ^ (n + 1) * (P.q z * P.R n (shift σ z) (σ [], z)) := fun z => by ring
    simp only [e]
    ring

/-- **Telescoping**: for a plan feasible for `n` periods,
`J_n + β^n E[V(s_n)] ≤ V(s₀)`. -/
theorem J_add_T_le (n : ℕ) : ∀ (σ : List Z → ℝ) (s : ℝ × Z), 0 < s.1 → P.FeasN n σ s →
    P.J n σ s + P.β ^ n * P.T P.V n σ s ≤ P.V s := by
  induction n with
  | zero => intro σ s _ _; simp [J, T]
  | succ n ih =>
    intro σ s hk hf
    obtain ⟨h0, h1, hf'⟩ := hf
    have hstep : ∀ z', P.q z' * (P.J n (shift σ z') (σ [], z') +
        P.β ^ n * P.T P.V n (shift σ z') (σ [], z')) ≤ P.q z' * P.V (σ [], z') := fun z' =>
      mul_le_mul_of_nonneg_left (ih _ _ h0 (hf' z')) (P.q_nonneg z')
    have hsum := Finset.sum_le_sum fun z' (_ : z' ∈ Finset.univ) => hstep z'
    have hb := P.bellman_le hk h0 h1
    rw [J, T, pow_succ]
    have hβ := P.β_pos
    have : P.β * ∑ z', P.q z' * (P.J n (shift σ z') (σ [], z') +
        P.β ^ n * P.T P.V n (shift σ z') (σ [], z')) ≤
        P.β * ∑ z', P.q z' * P.V (σ [], z') := mul_le_mul_of_nonneg_left hsum hβ.le
    simp only [mul_add, sum_add_distrib, mul_sum] at this ⊢
    have e : ∀ z', P.β ^ n * P.β * (P.q z' * P.T P.V n (shift σ z') (σ [], z')) =
        P.β * (P.q z' * (P.β ^ n * P.T P.V n (shift σ z') (σ [], z'))) := fun z' => by ring
    simp only [e]
    rw [mul_sum] at hb
    linarith

/-- **Lower bound in expectation**: `a₀ + (1/(1-αβ)) E[log c_n] ≤ E[V(s_n)]`. -/
theorem lower_R_le_T (n : ℕ) : ∀ (σ : List Z → ℝ) (s : ℝ × Z), 0 < s.1 → P.FeasN (n + 1) σ s →
    P.K + P.β * P.abar + 1 / (1 - P.α * P.β) * P.R n σ s ≤ P.T P.V n σ s := by
  induction n with
  | zero =>
    intro σ s hk hf
    exact P.lowerBound hk hf.1 hf.2.1
  | succ n ih =>
    intro σ s hk hf
    obtain ⟨h0, -, hf'⟩ := hf
    rw [R, T]
    have hstep := fun z' => mul_le_mul_of_nonneg_left (ih _ _ h0 (hf' z')) (P.q_nonneg z')
    have hsum := Finset.sum_le_sum fun z' (_ : z' ∈ Finset.univ) => hstep z'
    simp only [mul_add, sum_add_distrib, ← sum_mul, P.q_sum, one_mul, mul_sum] at hsum ⊢
    have e : ∀ z', P.q z' * (1 / (1 - P.α * P.β) * P.R n (shift σ z') (σ [], z')) =
        1 / (1 - P.α * P.β) * (P.q z' * P.R n (shift σ z') (σ [], z')) := fun z' => by ring
    simp only [e] at hsum
    linarith

/-! ### The policy plan -/

/-- `|log k|` stays bounded along the policy: with
`C = (|log αβ| + Σ_z |log A(z)|) / (1 - α)`, if `|log k| ≤ |log k₀| + C` then
the same holds for `αβ A(z) k^α`. -/
theorem log_g_bound {k₀ : ℝ} {s : ℝ × Z} (hk : 0 < s.1)
    (hb : |log s.1| ≤ |log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α)) :
    0 < P.g s ∧ |log (P.g s)| ≤
      |log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α) := by
  have hab := P.ab_pos
  have hy := P.y_pos hk
  have hA := P.A_pos s.2
  have h1α : 0 < 1 - P.α := by linarith [P.α_lt_one]
  set M := |log (P.α * P.β)| + ∑ z, |log (P.A z)|
  have hM : |log (P.α * P.β)| + |log (P.A s.2)| ≤ M := by
    have := single_le_sum (f := fun z => |log (P.A z)|) (fun z _ => abs_nonneg _)
      (mem_univ s.2)
    simp only [M]; linarith
  refine ⟨mul_pos hab hy, ?_⟩
  unfold g y
  rw [log_mul hab.ne' (mul_pos hA (rpow_pos_of_pos hk _)).ne',
    log_mul hA.ne' (rpow_pos_of_pos hk _).ne', log_rpow hk]
  have hα := P.α_pos
  calc |log (P.α * P.β) + (log (P.A s.2) + P.α * log s.1)|
      ≤ |log (P.α * P.β)| + |log (P.A s.2)| + P.α * |log s.1| := by
        have h1 := abs_add_le (log (P.α * P.β)) (log (P.A s.2) + P.α * log s.1)
        have h2 := abs_add_le (log (P.A s.2)) (P.α * log s.1)
        rw [abs_mul, abs_of_pos hα] at h2
        linarith
    _ ≤ M + P.α * (|log k₀| + M / (1 - P.α)) := by gcongr
    _ ≤ |log k₀| + M / (1 - P.α) := by
        have hM0 : 0 ≤ M := add_nonneg (abs_nonneg _) (sum_nonneg fun _ _ => abs_nonneg _)
        have : M = (1 - P.α) * (M / (1 - P.α)) := by field_simp
        nlinarith [abs_nonneg (log k₀), div_nonneg hM0 h1α.le]

/-- The policy plan is feasible for every horizon. -/
theorem feasN_policyPlan (n : ℕ) : ∀ s : ℝ × Z, 0 < s.1 →
    P.FeasN n (fun h => policyPlan P.g h s) s := by
  induction n with
  | zero => intro s _; trivial
  | succ n ih =>
    intro s hk
    have hy := P.y_pos hk
    have hab := P.ab_pos
    have hab1 := P.ab_lt_one
    refine ⟨mul_pos hab hy, by show P.α * P.β * P.y s < P.y s; nlinarith, fun z' => ?_⟩
    exact ih (P.g s, z') (mul_pos hab hy)

/-- Along the policy plan, `J_n + β^n E[V(s_n)] = V(s₀)`. -/
theorem J_add_T_policy (n : ℕ) : ∀ s : ℝ × Z, 0 < s.1 →
    P.J n (fun h => policyPlan P.g h s) s + P.β ^ n * P.T P.V n (fun h => policyPlan P.g h s) s =
      P.V s := by
  induction n with
  | zero => intro s _; simp [J, T]
  | succ n ih =>
    intro s hk
    have hg : 0 < P.g s := mul_pos P.ab_pos (P.y_pos hk)
    have e := P.bellman_eq hk
    have hsum : ∀ z', P.J n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z') +
        P.β ^ n * P.T P.V n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z') =
        P.V (P.g s, z') := fun z' => ih _ hg
    show P.F s (P.g s) +
        P.β * ∑ z', P.q z' * P.J n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z') +
        P.β ^ (n + 1) * ∑ z', P.q z' * P.T P.V n (fun h => policyPlan P.g h (P.g s, z'))
          (P.g s, z') = P.V s
    rw [← e]
    have hV : ∑ z', P.q z' * P.V (P.g s, z') =
        ∑ z', P.q z' * P.J n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z') +
        P.β ^ n * ∑ z', P.q z' * P.T P.V n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z') := by
      rw [mul_sum, ← sum_add_distrib]
      exact sum_congr rfl fun z' _ => by rw [← hsum z']; ring
    rw [hV, pow_succ]
    ring

/-- Along the policy plan from `k₀`, `E[V(s_n)]` is bounded. -/
theorem abs_T_policy_le {k₀ : ℝ} (n : ℕ) : ∀ s : ℝ × Z, 0 < s.1 →
    |log s.1| ≤ |log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α) →
    |P.T P.V n (fun h => policyPlan P.g h s) s| ≤
      ∑ z, |P.a z| + P.B * (|log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α)) := by
  have hB : 0 ≤ P.B := div_nonneg P.α_pos.le P.one_sub_ab_pos.le
  induction n with
  | zero =>
    intro s _ hb
    show |P.a s.2 + P.B * log s.1| ≤ _
    have ha := single_le_sum (f := fun z => |P.a z|) (fun z _ => abs_nonneg _) (mem_univ s.2)
    refine (abs_add_le _ _).trans (add_le_add ha ?_)
    rw [abs_mul, abs_of_nonneg hB]
    exact mul_le_mul_of_nonneg_left hb hB
  | succ n ih =>
    intro s hk hb
    obtain ⟨hg, hgb⟩ := P.log_g_bound hk hb
    rw [T]
    simp only [shift_policyPlan]
    set M := ∑ z, |P.a z| + P.B * (|log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α))
    calc |∑ z', P.q z' * P.T P.V n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z')|
        ≤ ∑ z', |P.q z' * P.T P.V n (fun h => policyPlan P.g h (P.g s, z')) (P.g s, z')| :=
          abs_sum_le_sum_abs _ _
      _ ≤ ∑ z', P.q z' * M := sum_le_sum fun z' _ => by
          rw [abs_mul, abs_of_nonneg (P.q_nonneg z')]
          exact mul_le_mul_of_nonneg_left (ih _ hg hgb) (P.q_nonneg z')
      _ = M := by rw [← sum_mul, P.q_sum, one_mul]

/-! ### Optimality -/

/-- **Stochastic Brock–Mirman.** For `k₀ > 0` and any initial shock `z₀`:
1. the plan generated by `k' = αβ A(z) k^α` is feasible and its expected
   payoffs `E[Σ_{t<n} β^t log c_t]` converge to `V(k₀, z₀)`;
2. every feasible contingent plan has expected payoffs eventually below
   `V(k₀, z₀) + ε`, for every `ε > 0`.
So `V(k₀, z₀) = a(z₀) + (α/(1-αβ)) log k₀` is the optimal value and the policy
`k' = αβ A(z) k^α` is optimal. -/
theorem stochastic_brockMirman {k₀ : ℝ} (hk₀ : 0 < k₀) (z₀ : Z) :
    P.Feasible (fun h => policyPlan P.g h (k₀, z₀)) (k₀, z₀) ∧
    Tendsto (fun n => P.J n (fun h => policyPlan P.g h (k₀, z₀)) (k₀, z₀)) atTop
      (𝓝 (P.V (k₀, z₀))) ∧
    ∀ σ : List Z → ℝ, P.Feasible σ (k₀, z₀) → ∀ ε > 0, ∀ᶠ n in atTop,
      P.J n σ (k₀, z₀) ≤ P.V (k₀, z₀) + ε := by
  set s₀ : ℝ × Z := (k₀, z₀)
  have hβ0 := P.β_pos
  have hβ1 := P.β_lt_one
  have h1 := P.one_sub_ab_pos
  refine ⟨fun n => P.feasN_policyPlan n s₀ hk₀, ?_, ?_⟩
  · -- `J_n = V - β^n E[V(s_n)]` with `E[V(s_n)]` bounded
    set M := ∑ z, |P.a z| + P.B * (|log k₀| + (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α))
    have hT : ∀ n, |P.T P.V n (fun h => policyPlan P.g h s₀) s₀| ≤ M := fun n =>
      P.abs_T_policy_le n s₀ hk₀ (by
        show |log k₀| ≤ _
        have : 0 ≤ (|log (P.α * P.β)| + ∑ z, |log (P.A z)|) / (1 - P.α) := by
          have : 0 < 1 - P.α := by linarith [P.α_lt_one]
          exact div_nonneg (add_nonneg (abs_nonneg _) (sum_nonneg fun _ _ => abs_nonneg _)) this.le
        linarith)
    have hlim : Tendsto (fun n : ℕ => P.β ^ n * P.T P.V n (fun h => policyPlan P.g h s₀) s₀)
        atTop (𝓝 0) := by
      have hp := (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1).mul_const M
      rw [zero_mul] at hp
      refine squeeze_zero_norm (fun n => ?_) hp
      rw [norm_mul, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hβ0.le n)]
      exact mul_le_mul_of_nonneg_left (hT n) (pow_nonneg hβ0.le n)
    have := (tendsto_const_nhds (x := P.V s₀)).sub hlim
    rw [sub_zero] at this
    refine this.congr fun n => ?_
    have := P.J_add_T_policy n s₀ hk₀
    linarith
  · intro σ hσ ε hε
    set b := 1 / (1 - P.α * P.β)
    set a₀ := P.K + P.β * P.abar
    have hb : 1 ≤ b := by
      simp only [b]; rw [le_div_iff₀ h1]; nlinarith [P.ab_pos]
    have hb0 : 0 < b := by linarith
    set u : ℕ → ℝ := fun n => P.J n σ s₀
    set v := P.V s₀
    set s : ℕ → ℝ := fun n => max (u n - v) 0
    have hrec : ∀ n, s (n + 1) ≤ ((b - 1) / b) * s n + (|a₀| / b) * P.β ^ n := by
      intro n
      have hJ := P.J_succ n σ s₀
      have htel := P.J_add_T_le n σ s₀ hk₀ (hσ n)
      have hlow := P.lower_R_le_T n σ s₀ hk₀ (hσ (n + 1))
      have hβn : 0 ≤ P.β ^ n := pow_nonneg hβ0.le n
      have h2 := mul_le_mul_of_nonneg_left hlow hβn
      have ha : -(|a₀| * P.β ^ n) ≤ a₀ * P.β ^ n := by have := neg_abs_le a₀; nlinarith
      have hsn : u n - v ≤ s n := le_max_left _ _
      have hsn0 : 0 ≤ s n := le_max_right _ _
      have hu1 : u (n + 1) = u n + P.β ^ n * P.R n σ s₀ := hJ
      have key : b * (u (n + 1) - v) ≤ (b - 1) * s n + |a₀| * P.β ^ n := by
        have : (b - 1) * (u n - v) ≤ (b - 1) * s n :=
          mul_le_mul_of_nonneg_left hsn (by linarith)
        have hu : u n + P.β ^ n * P.T P.V n σ s₀ ≤ v := htel
        rw [hu1]
        nlinarith
      apply max_le
      · rw [div_mul_eq_mul_div, div_mul_eq_mul_div, ← add_div, le_div_iff₀ hb0]
        linarith
      · have : 0 ≤ (b - 1) / b * s n := mul_nonneg (div_nonneg (by linarith) hb0.le) hsn0
        have : 0 ≤ |a₀| / b * P.β ^ n := mul_nonneg (div_nonneg (abs_nonneg a₀) hb0.le) hβn
        linarith
    have hlim : Tendsto s atTop (𝓝 0) :=
      tendsto_zero_of_le_mul_add_pow (fun n => le_max_right _ _)
        (by rw [div_lt_one hb0]; linarith)
        (div_nonneg (abs_nonneg a₀) hb0.le) hβ0.le hβ1 hrec
    filter_upwards [hlim.eventually (gt_mem_nhds hε)] with n hn
    have : u n - v ≤ s n := le_max_left _ _
    show u n ≤ v + ε
    linarith

end Params

/-- A non-vacuity witness: `α = 1/3`, `β = 9/10`, productivity `A ∈ {1/2, 2}`
with probability `1/2` each. -/
noncomputable def example₁ : Params (Fin 2) where
  α := 1 / 3
  β := 9 / 10
  A := ![1 / 2, 2]
  q := fun _ => 1 / 2
  α_pos := by norm_num
  α_lt_one := by norm_num
  β_pos := by norm_num
  β_lt_one := by norm_num
  A_pos := fun z => by fin_cases z <;> norm_num
  q_nonneg := fun _ => by norm_num
  q_sum := by norm_num [Fin.sum_univ_two]

end StochBrockMirman

end Econ
