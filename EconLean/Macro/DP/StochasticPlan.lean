/-
# Stochastic dynamic programming: the sequence problem and the principle of optimality

Stokey–Lucas (SL) §9.1–9.2, Thms 9.2–9.5, specialised to finitely many shocks
(`Z` finite, Markov transition `Q`).

`Stochastic.lean` builds the Bellman fixed point `V` of a `StochDynProg`. Here
we show `V` is the value of the **stochastic sequence problem**: the best
expected discounted payoff over contingent plans.

**Contingent plans.** With finitely many shocks, a plan is a function `σ` on
finite shock histories, `σ : List Z → X`. `σ []` is today's choice of the next
state `x₁` (today's shock `z₀` is known). `σ [z₁, …, zₙ]` is the choice of
`x_{n+1}` after the shocks `z₁, …, zₙ` have been observed. Plans are therefore
measurable with respect to the shock history by construction, which is SL's
measurability requirement for finite `Z`. The state at node `h` is
`stateAt σ s h`. The plan is **feasible** from `s = (x₀, z₀)` if every choice
lies in the feasible set at its node.

**Expected payoff.** The `n`-period expected payoff is defined by backward
recursion:

  `J_{n+1}(σ, s) = F(s, σ[]) + β Σ_{z'} Q(z, z') J_n(σ after z', (σ[], z'))`.

This is exactly `E[Σ_{t<n} β^t F(x_t, z_t, x_{t+1})]` under the Markov law.
`J_n` converges for every feasible plan, because `F` is bounded and `β < 1`.
Its limit is `expectedPayoff σ s`.

**Results.**
* `tendsto_expectedPayoff`: the expected payoff of every feasible plan is well
  defined (as the limit).
* `isGreatest_expectedPayoff` (SL Thm 9.2 + 9.4): `V(s)` is the **maximum**
  of the expected payoff over feasible plans. Every plan generated by a
  selection from the optimal policy attains it.
* `policy_of_optimal` (SL Thm 9.5, first period): if a feasible plan attains
  `V(s)`, its first choice lies in the optimal policy `G(s)`.

**Deviation.** SL's Thm 9.5 says an optimal plan follows the policy *almost
surely at every date*. We state it for the first period only. At later
nodes it holds for every history of positive probability, but this file does
not formalise "positive probability".
-/
module

public import EconLean.Macro.DP.Stochastic
public import Mathlib.Analysis.SpecificLimits.Basic

@[expose] public section

namespace Econ

open BoundedContinuousFunction Filter Topology Set Finset

namespace StochDynProg

variable {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] [DiscreteTopology Z]
  [Fintype Z] (P : StochDynProg X Z)

/-- The continuation of a contingent plan after the shock `z`. -/
def shift (σ : List Z → X) (z : Z) : List Z → X := fun h => σ (z :: h)

/-- The state `(x, z)` at the node reached by the shock history `h`. -/
def stateAt : (List Z → X) → X × Z → List Z → X × Z
  | _, s, [] => s
  | σ, _, z :: h => stateAt (shift σ z) (σ [], z) h

/-- A contingent plan is **feasible** from `s` if every choice is feasible at
its node. -/
def IsFeasible (σ : List Z → X) (s : X × Z) : Prop := ∀ h, σ h ∈ P.Γ (stateAt σ s h)

/-- `n`-period expected discounted payoff of a contingent plan, by backward
recursion over the Markov chain. -/
def payoffN : ℕ → (List Z → X) → X × Z → ℝ
  | 0, _, _ => 0
  | n + 1, σ, s => P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * payoffN n (shift σ z') (σ [], z')

/-- The plan generated by a policy function `g`: `x_{t+1} = g(x_t, z_t)`. -/
def policyPlan (g : X × Z → X) : X × Z → List Z → X
  | s, [] => g s
  | s, z :: h => policyPlan g (g s, z) h

variable {P}

theorem IsFeasible.head {σ : List Z → X} {s : X × Z} (h : P.IsFeasible σ s) : σ [] ∈ P.Γ s :=
  h []

theorem IsFeasible.shift {σ : List Z → X} {s : X × Z} (h : P.IsFeasible σ s) (z : Z) :
    P.IsFeasible (shift σ z) (σ [], z) := fun h' => h (z :: h')

variable (P)

theorem sum_Q_mul_add (z : Z) (a : Z → ℝ) (c : ℝ) :
    ∑ z', P.Q z z' * (a z' + c) = ∑ z', P.Q z z' * a z' + c := by
  simp only [mul_add, Finset.sum_add_distrib, ← Finset.sum_mul, P.Q_sum, one_mul]

theorem value_ge (s : X × Z) {y : X} (hy : y ∈ P.Γ s) :
    P.F s y + P.β * ∑ z', P.Q s.2 z' * P.value (y, z') ≤ P.value s :=
  (P.bellman_equation s).2 ⟨y, hy, rfl⟩

theorem value_eq_of_mem_policy {s : X × Z} {y : X} (hy : y ∈ P.policy s) :
    P.F s y + P.β * ∑ z', P.Q s.2 z' * P.value (y, z') = P.value s := by
  refine le_antisymm (P.value_ge s hy.1) ?_
  obtain ⟨y₀, hy₀, he⟩ := (P.bellman_equation s).1
  rw [← he]
  exact hy.2 y₀ hy₀

theorem abs_value_le (s : X × Z) : |P.value s| ≤ ‖P.value‖ := by
  have h := P.value.norm_coe_le_norm s
  rwa [Real.norm_eq_abs] at h

/-- No feasible plan beats `V` by more than `βⁿ ‖V‖` over `n` periods. -/
theorem payoffN_le {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s) (n : ℕ) :
    P.payoffN n σ s ≤ P.value s + P.β ^ n * ‖P.value‖ := by
  induction n generalizing σ s with
  | zero =>
    show (0 : ℝ) ≤ P.value s + P.β ^ 0 * ‖P.value‖
    rw [pow_zero, one_mul]
    linarith [neg_abs_le (P.value s), P.abs_value_le s]
  | succ n ih =>
    show P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * P.payoffN n (shift σ z') (σ [], z') ≤ _
    have h1 : ∑ z', P.Q s.2 z' * P.payoffN n (shift σ z') (σ [], z') ≤
        ∑ z', P.Q s.2 z' * (P.value (σ [], z') + P.β ^ n * ‖P.value‖) :=
      Finset.sum_le_sum fun z' _ =>
        mul_le_mul_of_nonneg_left (ih (hσ.shift z')) (P.Q_nonneg _ _)
    rw [P.sum_Q_mul_add] at h1
    have h2 := P.value_ge s hσ.head
    have h3 := mul_le_mul_of_nonneg_left h1 P.β_pos.le
    rw [pow_succ]
    nlinarith

/-- The policy plan does at least `V - βⁿ ‖V‖` over `n` periods. -/
theorem payoffN_policy_ge {g : X × Z → X} (hg : ∀ s, g s ∈ P.policy s) (s : X × Z) (n : ℕ) :
    P.value s - P.β ^ n * ‖P.value‖ ≤ P.payoffN n (policyPlan g s) s := by
  induction n generalizing s with
  | zero =>
    show P.value s - P.β ^ 0 * ‖P.value‖ ≤ 0
    rw [pow_zero, one_mul]
    linarith [le_abs_self (P.value s), P.abs_value_le s]
  | succ n ih =>
    show _ ≤ P.F s (g s) + P.β * ∑ z', P.Q s.2 z' * P.payoffN n (policyPlan g (g s, z')) (g s, z')
    have h1 : ∑ z', P.Q s.2 z' * (P.value (g s, z') + -(P.β ^ n * ‖P.value‖)) ≤
        ∑ z', P.Q s.2 z' * P.payoffN n (policyPlan g (g s, z')) (g s, z') :=
      Finset.sum_le_sum fun z' _ =>
        mul_le_mul_of_nonneg_left (by linarith [ih (g s, z')]) (P.Q_nonneg _ _)
    rw [P.sum_Q_mul_add] at h1
    have h2 := P.value_eq_of_mem_policy (hg s)
    have h3 := mul_le_mul_of_nonneg_left h1 P.β_pos.le
    rw [pow_succ]
    nlinarith

/-- The policy plan is feasible. -/
theorem isFeasible_policyPlan {g : X × Z → X} (hg : ∀ s, g s ∈ P.policy s) (s : X × Z) :
    P.IsFeasible (policyPlan g s) s := by
  intro h
  induction h generalizing s with
  | nil => exact (hg s).1
  | cons z h ih => exact ih (g s, z)

/-- Successive expected payoffs differ by at most `bound · βⁿ`. -/
theorem abs_payoffN_succ_sub_le {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s) (n : ℕ) :
    |P.payoffN (n + 1) σ s - P.payoffN n σ s| ≤ P.bound * P.β ^ n := by
  induction n generalizing σ s with
  | zero =>
    show |P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * 0 - 0| ≤ P.bound * P.β ^ 0
    simpa using P.abs_F_le hσ.head
  | succ n ih =>
    have e : P.payoffN (n + 2) σ s - P.payoffN (n + 1) σ s =
        P.β * ∑ z', P.Q s.2 z' * (P.payoffN (n + 1) (shift σ z') (σ [], z') -
          P.payoffN n (shift σ z') (σ [], z')) := by
      show (P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * P.payoffN (n + 1) (shift σ z') (σ [], z')) -
        (P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * P.payoffN n (shift σ z') (σ [], z')) = _
      simp only [mul_sub, Finset.sum_sub_distrib]
      ring
    rw [e, abs_mul, abs_of_pos P.β_pos]
    have h1 : |∑ z', P.Q s.2 z' * (P.payoffN (n + 1) (shift σ z') (σ [], z') -
        P.payoffN n (shift σ z') (σ [], z'))| ≤ ∑ z', P.Q s.2 z' * (P.bound * P.β ^ n) := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun z' _ => ?_)
      rw [abs_mul, abs_of_nonneg (P.Q_nonneg _ _)]
      exact mul_le_mul_of_nonneg_left (ih (hσ.shift z')) (P.Q_nonneg _ _)
    rw [← Finset.sum_mul, P.Q_sum, one_mul] at h1
    rw [pow_succ]
    nlinarith [P.β_pos]

/-- The expected discounted payoff of a feasible plan converges. -/
theorem exists_tendsto_payoffN {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s) :
    ∃ w, Tendsto (fun n => P.payoffN n σ s) atTop (𝓝 w) :=
  cauchySeq_tendsto_of_complete <| cauchySeq_of_le_geometric P.β P.bound P.β_lt_one fun n => by
    rw [Real.dist_eq, abs_sub_comm]; exact P.abs_payoffN_succ_sub_le hσ n

/-- The **expected discounted payoff** `E[Σ_t β^t F(x_t, z_t, x_{t+1})]` of a plan. -/
noncomputable def expectedPayoff (σ : List Z → X) (s : X × Z) : ℝ :=
  limUnder atTop fun n => P.payoffN n σ s

theorem tendsto_expectedPayoff {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s) :
    Tendsto (fun n => P.payoffN n σ s) atTop (𝓝 (P.expectedPayoff σ s)) :=
  tendsto_nhds_limUnder (P.exists_tendsto_payoffN hσ)

theorem tendsto_value_add (s : X × Z) (c : ℝ) :
    Tendsto (fun n => P.value s + c * (P.β ^ n * ‖P.value‖)) atTop (𝓝 (P.value s)) := by
  have := ((tendsto_pow_atTop_nhds_zero_of_lt_one P.β_pos.le P.β_lt_one).mul_const
    ‖P.value‖).const_mul c
  simpa using tendsto_const_nhds.add this

theorem expectedPayoff_le {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s) :
    P.expectedPayoff σ s ≤ P.value s :=
  le_of_tendsto_of_tendsto' (P.tendsto_expectedPayoff hσ) (P.tendsto_value_add s 1)
    fun n => by simpa using P.payoffN_le hσ n

theorem expectedPayoff_policyPlan {g : X × Z → X} (hg : ∀ s, g s ∈ P.policy s) (s : X × Z) :
    P.expectedPayoff (policyPlan g s) s = P.value s := by
  refine tendsto_nhds_unique (P.tendsto_expectedPayoff (P.isFeasible_policyPlan hg s)) ?_
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le (P.tendsto_value_add s (-1))
    (P.tendsto_value_add s 1) (fun n => ?_) (fun n => ?_)
  · simpa [sub_eq_add_neg] using P.payoffN_policy_ge hg s n
  · simpa using P.payoffN_le (P.isFeasible_policyPlan hg s) n

/-- A measurable (here: any) selection from the optimal policy exists. -/
theorem exists_policy_selection : ∃ g : X × Z → X, ∀ s, g s ∈ P.policy s :=
  ⟨fun s => (P.policy_nonempty_compact_uhc.1 s).1.some,
    fun s => (P.policy_nonempty_compact_uhc.1 s).1.some_mem⟩

/-- **Stochastic principle of optimality** (SL Thms 9.2 and 9.4, finite
shocks): `V(s)` is the greatest expected discounted payoff over feasible
contingent plans from `s`. Every plan generated by a selection from the
optimal policy attains it. -/
theorem isGreatest_expectedPayoff (s : X × Z) :
    IsGreatest {w | ∃ σ, P.IsFeasible σ s ∧ P.expectedPayoff σ s = w} (P.value s) := by
  obtain ⟨g, hg⟩ := P.exists_policy_selection
  exact ⟨⟨policyPlan g s, P.isFeasible_policyPlan hg s, P.expectedPayoff_policyPlan hg s⟩,
    fun w ⟨σ, hσ, hw⟩ => hw ▸ P.expectedPayoff_le hσ⟩

/-- **Optimal plans follow the policy** (SL Thm 9.5, first period): if a
feasible plan attains `V(s)`, its first choice is in the policy `G(s)`. -/
theorem policy_of_optimal {σ : List Z → X} {s : X × Z} (hσ : P.IsFeasible σ s)
    (hopt : P.expectedPayoff σ s = P.value s) : σ [] ∈ P.policy s := by
  set y := σ []
  set obj := P.F s y + P.β * ∑ z', P.Q s.2 z' * P.value (y, z')
  have hbound : ∀ n, P.payoffN (n + 1) σ s ≤ obj + P.β * (P.β ^ n * ‖P.value‖) := by
    intro n
    show P.F s (σ []) + P.β * ∑ z', P.Q s.2 z' * P.payoffN n (shift σ z') (σ [], z') ≤ _
    have h1 : ∑ z', P.Q s.2 z' * P.payoffN n (shift σ z') (σ [], z') ≤
        ∑ z', P.Q s.2 z' * (P.value (σ [], z') + P.β ^ n * ‖P.value‖) :=
      Finset.sum_le_sum fun z' _ =>
        mul_le_mul_of_nonneg_left (P.payoffN_le (hσ.shift z') n) (P.Q_nonneg _ _)
    rw [P.sum_Q_mul_add] at h1
    have h3 := mul_le_mul_of_nonneg_left h1 P.β_pos.le
    simp only [obj, y]
    nlinarith
  have hlim : Tendsto (fun n => P.payoffN (n + 1) σ s) atTop (𝓝 (P.value s)) :=
    hopt ▸ (P.tendsto_expectedPayoff hσ).comp (tendsto_add_atTop_nat 1)
  have hle : P.value s ≤ obj := by
    have hr : Tendsto (fun n => obj + P.β * (P.β ^ n * ‖P.value‖)) atTop (𝓝 obj) := by
      have := ((tendsto_pow_atTop_nhds_zero_of_lt_one P.β_pos.le P.β_lt_one).mul_const
        ‖P.value‖).const_mul P.β
      simpa using tendsto_const_nhds.add this
    exact le_of_tendsto_of_tendsto' hlim hr hbound
  exact ⟨hσ.head, fun y' hy' => (P.value_ge s hy').trans hle⟩

end StochDynProg

end Econ
