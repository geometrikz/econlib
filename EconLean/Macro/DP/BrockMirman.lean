/-
# The Brock–Mirman growth model: closed form via the general theory

Brock and Mirman (1972); Stokey–Lucas (SL) Exercise 2.3 / §4.4 example;
Ljungqvist–Sargent ch. 3.

**The model.** A planner with log utility and Cobb–Douglas technology with
full depreciation chooses next period's capital `k'` given capital `k`:

  `max Σ_t β^t log(c_t)`,  `c_t = k_t^α - k_{t+1}`,  `0 < k_{t+1} < k_t^α`,

with `0 < α < 1`, `0 < β < 1`, `k₀ > 0`. The famous closed form is

  `V(k) = A + B log k`,  `B = α / (1 - αβ)`,
  `A = [log(1 - αβ) + (αβ / (1 - αβ)) log(αβ)] / (1 - β)`,

with optimal policy `g(k) = αβ k^α` (save the fraction `αβ` of output).

**What we prove, and how.** This is the M5 exit criterion: the closed form is
verified *through the general theory*, twice.
1. `brockMirman_value`: `V(k₀)` is the optimal value of the sequence problem
   and the policy `g` attains it, via `verification_of_lowerBound`
   (`SequenceProblem.lean`). Log utility is unbounded below, so the bounded
   theory of `Bellman.lean` does not apply and SL's boundary condition fails;
   the lower-bound variant handles it.
2. `brockMirman_euler_equation`, `brockMirman_transversality`: the plan
   generated by `g` satisfies the Euler equation and the transversality
   condition; `brockMirman_optimal_of_euler` concludes it is optimal by SL
   Thm 4.15 (`euler_transversality`), an independent route to the same fact.

**Modelling choices.** The state space is `ℝ` with feasibility requiring
`k > 0` (so plans from `k₀ > 0` stay in `(0, ∞)`, where `log` and `k^α` mean
what they should; `Real.log 0 = 0` and `rpow` of negatives are never used).
Consumption is required to be strictly positive (`k' < k^α`), as log utility
makes zero consumption infinitely bad.
-/
module

public import EconLean.Macro.DP.SequenceProblem
public import Mathlib.Analysis.SpecialFunctions.Pow.Real
public import Mathlib.Analysis.Convex.SpecificFunctions.Basic

@[expose] public section

namespace Econ

namespace BrockMirman

open Real Filter Topology Set

/-- Feasible next-period capital: `0 < k' < k^α` (positive consumption), for
`k > 0`. -/
def Γ (α : ℝ) (k : ℝ) : Set ℝ := {k' | 0 < k ∧ 0 < k' ∧ k' < k ^ α}

/-- Period return: log of consumption `c = k^α - k'`. -/
noncomputable def F (α : ℝ) (k k' : ℝ) : ℝ := log (k ^ α - k')

/-- Slope coefficient of the value function, `α / (1 - αβ)`. -/
noncomputable def B (α β : ℝ) : ℝ := α / (1 - α * β)

/-- Intercept of the value function. -/
noncomputable def A (α β : ℝ) : ℝ :=
  (log (1 - α * β) + (α * β / (1 - α * β)) * log (α * β)) / (1 - β)

/-- The closed-form value function `V(k) = A + B log k`. -/
noncomputable def V (α β : ℝ) (k : ℝ) : ℝ := A α β + B α β * log k

/-- The closed-form policy `g(k) = αβ k^α`. -/
noncomputable def g (α β : ℝ) (k : ℝ) : ℝ := α * β * k ^ α

variable {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)

include hα0 hα1 hβ0 hβ1

omit hα1 hβ1 in
theorem ab_pos : 0 < α * β := mul_pos hα0 hβ0
omit hβ0 in
theorem ab_lt_one : α * β < 1 := by nlinarith

/-- The value at the optimum: `log c* + β V(k*) = V(k)` with `c* = (1-αβ)k^α`,
`k* = αβ k^α`. -/
theorem bellman_eq_at_policy {k : ℝ} (hk : 0 < k) :
    F α k (g α β k) + β * V α β (g α β k) = V α β k := by
  have hab := ab_pos hα0 hβ0
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have hy : 0 < k ^ α := rpow_pos_of_pos hk α
  have h1ab : (0 : ℝ) < 1 - α * β := by linarith
  have hc : k ^ α - α * β * k ^ α = (1 - α * β) * k ^ α := by ring
  simp only [F, V, g, A, B]
  rw [hc, log_mul h1ab.ne' hy.ne', log_mul hab.ne' hy.ne', log_rpow hk]
  field_simp
  ring

/-- **Bellman inequality** for the closed form: for every feasible `k'`,
`log(k^α - k') + β V(k') ≤ V(k)`. Proof: `log z ≤ z - 1` applied to the
ratios of consumption and saving to their optimal values. -/
theorem bellman_le {k k' : ℝ} (hk' : k' ∈ Γ α k) :
    F α k k' + β * V α β k' ≤ V α β k := by
  obtain ⟨hk, hk'0, hk'1⟩ := hk'
  have hab := ab_pos hα0 hβ0
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have hy : 0 < k ^ α := rpow_pos_of_pos hk α
  have h1ab : (0 : ℝ) < 1 - α * β := by linarith
  have hc : 0 < k ^ α - k' := by linarith
  -- compare with the value at the optimum
  rw [← bellman_eq_at_policy hα0 hα1 hβ0 hβ1 hk]
  simp only [F, V, g, B]
  have hcs : 0 < (1 - α * β) * k ^ α := mul_pos h1ab hy
  have hks : 0 < α * β * k ^ α := mul_pos hab hy
  have e1 : log (k ^ α - k') - log (k ^ α - α * β * k ^ α) ≤
      (k ^ α - k') / ((1 - α * β) * k ^ α) - 1 := by
    rw [← log_div hc.ne' (by nlinarith), show k ^ α - α * β * k ^ α = (1 - α * β) * k ^ α by ring]
    exact log_le_sub_one_of_pos (div_pos hc hcs)
  have e2 : log k' - log (α * β * k ^ α) ≤ k' / (α * β * k ^ α) - 1 := by
    rw [← log_div hk'0.ne' hks.ne']
    exact log_le_sub_one_of_pos (div_pos hk'0 hks)
  -- the weighted sum of the two linear bounds is exactly zero
  have hθ : 0 ≤ β * (α / (1 - α * β)) := by positivity
  have hzero : (k ^ α - k') / ((1 - α * β) * k ^ α) - 1 +
      β * (α / (1 - α * β)) * (k' / (α * β * k ^ α) - 1) = 0 := by
    field_simp; ring
  nlinarith [mul_le_mul_of_nonneg_left e2 hθ]

omit hβ0 in
/-- The value function is bounded below by a multiple (≥ 1) of today's return:
`A + (1/(1-αβ)) log(k^α - k') ≤ V(k)`, since `log c < log k^α = α log k`. -/
theorem lowerBound {k k' : ℝ} (hk' : k' ∈ Γ α k) :
    A α β + (1 / (1 - α * β)) * F α k k' ≤ V α β k := by
  obtain ⟨hk, hk'0, hk'1⟩ := hk'
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have hy : 0 < k ^ α := rpow_pos_of_pos hk α
  have hlog : log (k ^ α - k') ≤ α * log k := by
    rw [← log_rpow hk]; exact log_le_log (by linarith) (by linarith)
  simp only [V, F, B]
  have : 0 < 1 / (1 - α * β) := by apply div_pos one_pos; linarith
  have h := mul_le_mul_of_nonneg_left hlog this.le
  rw [show α / (1 - α * β) * log k = 1 / (1 - α * β) * (α * log k) by ring]
  linarith

omit hβ1 in
/-- Along the policy plan, `log k_t` stays bounded: `|log k_t| ≤ |log k₀| + |log αβ|/(1-α)`. -/
theorem policy_plan_bounds {k₀ : ℝ} (hk₀ : 0 < k₀) (t : ℕ) :
    0 < planOf (g α β) k₀ t ∧
      |log (planOf (g α β) k₀ t)| ≤ |log k₀| + |log (α * β)| / (1 - α) := by
  have hab := ab_pos hα0 hβ0
  have h1α : 0 < 1 - α := by linarith
  have hC : 0 ≤ |log (α * β)| / (1 - α) := by positivity
  induction t with
  | zero => exact ⟨hk₀, by simp [planOf]; linarith⟩
  | succ t ih =>
    obtain ⟨hpos, hbd⟩ := ih
    rw [planOf_succ]
    set k := planOf (g α β) k₀ t
    have hy : 0 < k ^ α := rpow_pos_of_pos hpos α
    refine ⟨mul_pos hab hy, ?_⟩
    simp only [g]
    rw [log_mul hab.ne' hy.ne', log_rpow hpos]
    calc |log (α * β) + α * log k| ≤ |log (α * β)| + α * |log k| := by
          refine (abs_add_le _ _).trans ?_
          rw [abs_mul, abs_of_pos hα0]
      _ ≤ |log (α * β)| + α * (|log k₀| + |log (α * β)| / (1 - α)) := by gcongr
      _ ≤ |log k₀| + |log (α * β)| / (1 - α) := by
          have : |log (α * β)| = (1 - α) * (|log (α * β)| / (1 - α)) := by field_simp
          nlinarith [abs_nonneg (log k₀)]

omit hα0 hα1 hβ0 hβ1 in
theorem Γ_subset {k : ℝ} : Γ α k ⊆ Ioi 0 := fun _ h => h.2.1

/-- **Brock–Mirman, value form (M5 exit criterion).**
For `0 < α, β < 1` and `k₀ > 0`, the closed form
`A + (α / (1 - αβ)) log k₀` is the optimal value of the sequence problem
`max Σ β^t log(k_t^α - k_{t+1})`, and the plan `k_{t+1} = αβ k_t^α` attains it
(its partial payoffs converge to the value, and it is an optimal plan). -/
theorem brockMirman_value {k₀ : ℝ} (hk₀ : 0 < k₀) :
    IsOptimalValue (Γ α) (F α) β k₀
        ((log (1 - α * β) + (α * β / (1 - α * β)) * log (α * β)) / (1 - β) +
          α / (1 - α * β) * log k₀) ∧
      IsOptimalPlan (Γ α) (F α) β k₀ (planOf (fun k => α * β * k ^ α) k₀) ∧
      Tendsto (partialPayoff (F α) β (planOf (fun k => α * β * k ^ α) k₀)) atTop
        (𝓝 ((log (1 - α * β) + (α * β / (1 - α * β)) * log (α * β)) / (1 - β) +
          α / (1 - α * β) * log k₀)) := by
  have hab := ab_pos hα0 hβ0
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have hb : 1 ≤ 1 / (1 - α * β) := by
    rw [le_div_iff₀ (by linarith)]; nlinarith
  have hgΓ : ∀ k ∈ Ioi (0 : ℝ), g α β k ∈ Γ α k := fun k hk => by
    have hy : 0 < k ^ α := rpow_pos_of_pos hk α
    exact ⟨hk, mul_pos hab hy, by simp only [g]; nlinarith⟩
  -- policy plan: `β^n V(k_n) → 0` since `log k_n` is bounded
  have hpol : ∀ x₀ ∈ Ioi (0 : ℝ), ∀ ε > 0, ∀ᶠ n in atTop,
      β ^ n * V α β (planOf (g α β) x₀ n) ≤ ε := by
    intro x₀ hx₀ ε hε
    set C := |A α β| + B α β * (|log x₀| + |log (α * β)| / (1 - α))
    have hB : 0 < B α β := div_pos hα0 (by linarith)
    have hlim : Tendsto (fun n : ℕ => β ^ n * C) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1).mul_const C
    filter_upwards [hlim.eventually (gt_mem_nhds hε)] with n hn
    have hbd := (policy_plan_bounds hα0 hα1 hβ0 hx₀ n).2
    have hV : V α β (planOf (g α β) x₀ n) ≤ C := by
      simp only [V, C]
      have := neg_abs_le (log (planOf (g α β) x₀ n))
      have := le_abs_self (log (planOf (g α β) x₀ n))
      have := le_abs_self (A α β)
      nlinarith
    have := mul_le_mul_of_nonneg_left hV (pow_nonneg hβ0.le n)
    linarith
  have h := verification_of_lowerBound hβ0.le hβ1 (S := Ioi 0) (fun _ _ => Γ_subset)
    (v := V α β) (g := g α β)
    (fun x _ y hy => bellman_le hα0 hα1 hβ0 hβ1 hy)
    (fun x hx => ⟨hgΓ x hx, bellman_eq_at_policy hα0 hα1 hβ0 hβ1 hx⟩)
    hb (fun x _ y hy => lowerBound hα0 hα1 hβ1 hy) hpol (mem_Ioi.2 hk₀)
  have hfeas : IsFeasiblePlan (Γ α) k₀ (planOf (g α β) k₀) := by
    refine ⟨rfl, fun t => ?_⟩
    rw [planOf_succ]
    exact hgΓ _ (policy_plan_bounds hα0 hα1 hβ0 hk₀ t).1
  exact ⟨h.1, h.1.isOptimalPlan hfeas h.2, h.2⟩

/-! ### The same plan via Euler equation + transversality -/

/-- Marginal return of capital today, `F_k = α k^{α-1} / c`, as a linear map. -/
noncomputable def Fk (α : ℝ) (k k' : ℝ) : ℝ →ₗ[ℝ] ℝ :=
  (α * k ^ (α - 1) / (k ^ α - k')) • LinearMap.id

/-- Marginal return of saving, `F_{k'} = -1 / c`, as a linear map. -/
noncomputable def Fk' (α : ℝ) (k k' : ℝ) : ℝ →ₗ[ℝ] ℝ :=
  (-1 / (k ^ α - k')) • LinearMap.id

omit hβ0 hβ1 in
/-- `F(k, k') = log(k^α - k')` is concave on the graph: supergradient inequality. -/
theorem supergradient {k y k' y' : ℝ} (hy : y ∈ Γ α k) (hy' : y' ∈ Γ α k') :
    F α k' y' ≤ F α k y + Fk α k y (k' - k) + Fk' α k y (y' - y) := by
  obtain ⟨hk, -, hy1⟩ := hy
  obtain ⟨hk', -, hy1'⟩ := hy'
  have hc : 0 < k ^ α - y := by linarith
  have hc' : 0 < k' ^ α - y' := by linarith
  -- concavity of `k ↦ k^α` (Bernoulli): `k'^α ≤ k^α + α k^{α-1} (k' - k)`
  have hpow : k' ^ α ≤ k ^ α + α * k ^ (α - 1) * (k' - k) := by
    have hs : (-1 : ℝ) ≤ k' / k - 1 := by
      have := div_pos hk' hk; linarith
    have hb := rpow_one_add_le_one_add_mul_self hs hα0.le hα1.le
    have e : k' = k * (1 + (k' / k - 1)) := by field_simp; ring
    rw [e, mul_rpow hk.le (by linarith), rpow_sub_one hk.ne']
    have hy0 : 0 < k ^ α := rpow_pos_of_pos hk α
    calc k ^ α * (1 + (k' / k - 1)) ^ α ≤ k ^ α * (1 + α * (k' / k - 1)) :=
          mul_le_mul_of_nonneg_left hb hy0.le
      _ = k ^ α + α * (k ^ α / k) * (k * (1 + (k' / k - 1)) - k) := by field_simp; ring
  -- concavity of `log`: `log z ≤ log c + (z - c)/c`
  have hlog : log (k' ^ α - y') ≤ log (k ^ α - y) + (k' ^ α - y' - (k ^ α - y)) / (k ^ α - y) := by
    have := log_le_sub_one_of_pos (div_pos hc' hc)
    rw [log_div hc'.ne' hc.ne'] at this
    have e : (k' ^ α - y') / (k ^ α - y) - 1 = (k' ^ α - y' - (k ^ α - y)) / (k ^ α - y) := by
      field_simp
    linarith
  simp only [F, Fk, Fk', LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul]
  have : (k' ^ α - y' - (k ^ α - y)) / (k ^ α - y) ≤
      α * k ^ (α - 1) / (k ^ α - y) * (k' - k) + -1 / (k ^ α - y) * (y' - y) := by
    rw [div_mul_eq_mul_div, div_mul_eq_mul_div, ← add_div]
    exact div_le_div_of_nonneg_right (by linarith) hc.le
  linarith

/-- **Euler equation along the Brock–Mirman plan**: with `c_t = k_t^α - k_{t+1}`,
`1 / c_t = β α k_{t+1}^{α-1} / c_{t+1}` (marginal utility today equals discounted
marginal utility tomorrow times the marginal product of capital). -/
theorem brockMirman_euler_equation {k₀ : ℝ} (hk₀ : 0 < k₀) (t : ℕ) :
    let k := planOf (fun k => α * β * k ^ α) k₀
    1 / (k t ^ α - k (t + 1)) = β * (α * k (t + 1) ^ (α - 1)) / (k (t + 1) ^ α - k (t + 2)) := by
  intro k
  show 1 / (planOf (g α β) k₀ t ^ α - planOf (g α β) k₀ (t + 1)) =
    β * (α * planOf (g α β) k₀ (t + 1) ^ (α - 1)) /
      (planOf (g α β) k₀ (t + 1) ^ α - planOf (g α β) k₀ (t + 2))
  have hab := ab_pos hα0 hβ0
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have h1ab : (0 : ℝ) < 1 - α * β := by linarith
  set ks := planOf (g α β) k₀
  have hpos : ∀ t, 0 < ks t := fun t => (policy_plan_bounds hα0 hα1 hβ0 hk₀ t).1
  have hsucc : ∀ t, ks (t + 1) = α * β * ks t ^ α := fun t => planOf_succ _ _ t
  have hcons : ∀ t, ks t ^ α - ks (t + 1) = (1 - α * β) * ks t ^ α := fun t => by
    rw [hsucc]; ring
  rw [hcons, show t + 2 = (t + 1) + 1 by ring, hcons, rpow_sub_one (hpos (t + 1)).ne', hsucc t]
  have hy : 0 < ks t ^ α := rpow_pos_of_pos (hpos t) α
  have hy' : 0 < (α * β * ks t ^ α) ^ α := rpow_pos_of_pos (mul_pos hab hy) α
  field_simp

/-- **Transversality along the Brock–Mirman plan**:
`β^t F_k(k_t, k_{t+1}) k_t = β^t α k_t^{α-1} k_t / c_t → 0`
(it equals `β^t α / (1 - αβ)`). -/
theorem brockMirman_transversality {k₀ : ℝ} (hk₀ : 0 < k₀) :
    let k := planOf (fun k => α * β * k ^ α) k₀
    Tendsto (fun t => β ^ t * (α * k t ^ (α - 1) / (k t ^ α - k (t + 1))) * k t) atTop (𝓝 0) := by
  intro k
  show Tendsto (fun t => β ^ t * (α * planOf (g α β) k₀ t ^ (α - 1) /
    (planOf (g α β) k₀ t ^ α - planOf (g α β) k₀ (t + 1))) * planOf (g α β) k₀ t) atTop (𝓝 0)
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have h1ab : (0 : ℝ) < 1 - α * β := by linarith
  set ks := planOf (g α β) k₀
  have hpos : ∀ t, 0 < ks t := fun t => (policy_plan_bounds hα0 hα1 hβ0 hk₀ t).1
  have hsucc : ∀ t, ks (t + 1) = α * β * ks t ^ α := fun t => planOf_succ _ _ t
  have hcons : ∀ t, ks t ^ α - ks (t + 1) = (1 - α * β) * ks t ^ α := fun t => by
    rw [hsucc]; ring
  have e : ∀ t, β ^ t * (α * ks t ^ (α - 1) / (ks t ^ α - ks (t + 1))) * ks t =
      β ^ t * (α / (1 - α * β)) := by
    intro t
    rw [hcons, rpow_sub_one (hpos t).ne']
    have hy : 0 < ks t ^ α := rpow_pos_of_pos (hpos t) α
    have := hpos t
    field_simp
  simp_rw [e]
  simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1).mul_const (α / (1 - α * β))

/-- **Brock–Mirman via SL Thm 4.15**: since the savings plan `k_{t+1} = αβ k_t^α`
satisfies the Euler equation and the transversality condition
(`brockMirman_euler_equation`, `brockMirman_transversality`), it is optimal.
This is an independent check of the second conclusion of `brockMirman_value`. -/
theorem brockMirman_optimal_of_euler {k₀ : ℝ} (hk₀ : 0 < k₀) :
    IsOptimalPlan (Γ α) (F α) β k₀ (planOf (fun k => α * β * k ^ α) k₀) := by
  show IsOptimalPlan (Γ α) (F α) β k₀ (planOf (g α β) k₀)
  have hab := ab_pos hα0 hβ0
  have hab1 := ab_lt_one hα0 hα1 hβ1
  have h1ab : (0 : ℝ) < 1 - α * β := by linarith
  set ks := planOf (g α β) k₀
  have hpos : ∀ t, 0 < ks t := fun t => (policy_plan_bounds hα0 hα1 hβ0 hk₀ t).1
  have hsucc : ∀ t, ks (t + 1) = α * β * ks t ^ α := fun t => planOf_succ _ _ t
  have hfeas : IsFeasiblePlan (Γ α) k₀ ks := by
    refine ⟨rfl, fun t => ?_⟩
    have hy : 0 < ks t ^ α := rpow_pos_of_pos (hpos t) α
    rw [hsucc]; exact ⟨hpos t, mul_pos hab hy, by nlinarith⟩
  -- consumption along the plan: `c_t = (1 - αβ) k_t^α`
  have hcons : ∀ t, ks t ^ α - ks (t + 1) = (1 - α * β) * ks t ^ α := fun t => by
    rw [hsucc]; ring
  refine euler_transversality hβ0.le (Fk α) (Fk' α)
    (fun x y x' y' hy hy' => supergradient hα0 hα1 hy hy') (fun _ _ h => h.2.1.le)
    (fun x y z hy hz => ?_) hfeas (fun t => ?_) ?_
  · -- `F_k ≥ 0`
    obtain ⟨hx, -, hy1⟩ := hy
    simp only [Fk, LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul]
    have : 0 < x ^ α - y := by linarith
    have := rpow_pos_of_pos hx (α - 1)
    positivity
  · -- Euler equation
    ext
    simp only [Fk, Fk', LinearMap.add_apply, LinearMap.smul_apply, LinearMap.id_apply,
      smul_eq_mul, LinearMap.zero_apply]
    rw [hcons, show t + 2 = (t + 1) + 1 by ring, hcons, rpow_sub_one (hpos (t + 1)).ne',
      hsucc t]
    have hy : 0 < ks t ^ α := rpow_pos_of_pos (hpos t) α
    have hy' : 0 < (α * β * ks t ^ α) ^ α := rpow_pos_of_pos (mul_pos hab hy) α
    field_simp
    ring
  · -- transversality: `β^t F_k(k_t) k_t = β^t α / (1 - αβ) → 0`
    have e : ∀ t, β ^ t * Fk α (ks t) (ks (t + 1)) (ks t) = β ^ t * (α / (1 - α * β)) := by
      intro t
      simp only [Fk, LinearMap.smul_apply, LinearMap.id_apply, smul_eq_mul]
      rw [hcons, rpow_sub_one (hpos t).ne']
      have hy : 0 < ks t ^ α := rpow_pos_of_pos (hpos t) α
      have := hpos t
      field_simp
    simp_rw [e]
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1).mul_const (α / (1 - α * β))

end BrockMirman

end Econ
